-def replacement_data(summary, contrasts):
-    """Reverse saved B-minus-event estimates, bounds and category counts."""
-    year = _select(contrasts, cohort='all_channels', metric='sca550', category_a='background').copy()
-    year = year.loc[year.category_b.isin(h.CATS[1:])].copy()
-    year['contrast'] = year.category_b.map(dict(zip(h.CATS[1:], CONTRASTS)))
-    year['cliffs_delta'] = -year.cliffs_delta
-    low = -year.delta_ci_high.copy()
-    year['delta_ci_high'] = -year.delta_ci_low
-    year['delta_ci_low'] = low
-    old_a = year.n_a.copy()
-    year['n_a'], year['n_b'] = year.n_b, old_a
-    year['method'] = 'whole_year_reference'
-    chosen = _select(summary, cohort='all_channels', metric='sca550')
-    chosen = chosen.loc[chosen.method.isin([x[0] for x in METHODS[1:]]) & chosen.contrast.isin(CONTRASTS)]
-    return pd.concat([year, chosen], ignore_index=True)
