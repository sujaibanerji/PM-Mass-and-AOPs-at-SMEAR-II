@@ -0,0 +1,19 @@
+"""Display-only formatter; calculations and source data are not modified."""
+from decimal import Decimal, ROUND_HALF_UP, localcontext
+
+
+def display_number(value):
+    number = Decimal(str(value))
+    if not number.is_finite():
+        raise ValueError('A displayed result must be finite')
+    if number.is_zero():
+        return '0'
+    with localcontext() as ctx:
+        ctx.prec = max(50, len(number.as_tuple().digits) + 5)
+        quantum = Decimal(1).scaleb(number.copy_abs().adjusted() - 2)
+        rounded = number.quantize(quantum, rounding=ROUND_HALF_UP)
+        exponent = rounded.copy_abs().adjusted()
+        if -2 <= exponent < 3:
+            return format(rounded, f'.{max(0, 2 - exponent)}f')
+        coefficient = rounded.scaleb(-exponent)
+        return rf'{coefficient:.2f}\times10^{{{exponent}}}'
