+    release = verify_data(data_dir)
+    inputs = Inputs(data_dir, statistics_dir, scalar_dir)
+    inputs.record(inputs.root / 'manifest.json')
+    for directory in [inputs.statistics_dir, inputs.scalar_dir]:
+        if directory is not None and (output_dir.is_relative_to(directory) or directory.is_relative_to(output_dir)):
+            raise ValueError('Output and statistics/scalar exports must be separate, non-nested paths')
+    # prepare_output also rejects unrelated files, not just our named products.
+    output_dir = prepare_output(output_dir, data_dir)
+    settings, font_name = h.style_settings(ASSETS / 'fonts/lmroman12-regular.otf')
+    font_path = ASSETS / 'fonts/lmroman12-regular.otf'
+    if font_path.is_file():
+        inputs.record(font_path, 'codes/assets/fonts/lmroman12-regular.otf')
+    manifest = {'document': 'main_manuscript', 'reproducibility_level': 'frozen-observation-and-derived-table rendering',
+        'bootstrap_intervals': 'not displayed',
+        'raw_measurement_reprocessing': False, 'figures': [], 'inputs': inputs.records,
+        'font': font_name, 'bundled_font_used': font_path.is_file(), 'dpi': h.DPI,
+        'release': release.get('release'), 'data_checksums_verified': True,
+        'verified_data_file_count': len(release['files']), 'table_sources': inputs.table_sources,
+        'intended_width_mm': 164, 'effective_font_pt_at_intended_width': 10,
+        'software': {'python': sys.version.split()[0], 'numpy': np.__version__, 'pandas': pd.__version__, 'matplotlib': matplotlib.__version__}}
+    rendered = []
+    # Prepare and validate every figure before creating persistent output files.
+    with matplotlib.rc_context(settings):
+        existing_figures = set(plt.get_fignums())
+        try:
+            for number in figures:
+                if number == 1:
+                    payload, record = _schematic(inputs)
+                else:
+                    if number in [2, 3, 4]:
+                        fig, record = _distributions(inputs, number)
+                    elif number == 5:
+                        fig, record = _scalars(inputs)
+                    elif number == 6:
+                        fig, record = _pollen_mass(inputs)
+                    elif number == 7:
+                        fig, record = _spectra(inputs)
+                    else:
+                        fig, record = _effects(inputs)
+                    buffer = io.BytesIO()
+                    fig.savefig(buffer, format='png', dpi=h.DPI)
+                    payload = buffer.getvalue()
+                    plt.close(fig)
+                    record['mode'] = 'native_matplotlib'
+                if number == 8:
+                    source = inputs.table_sources['bootstrap_summary.csv']
+                    manifest['bootstrap_intervals'] = (
+                        'saved reference intervals; not recomputed' if source=='saved_reference' else
+                        'recomputed statistics exports with verified input/output provenance; renderer reads intervals' if source in ['verified_calculation_export','verified_native_calculation_export'] else
+                        'supplied statistics exports; calculation provenance unverified')
+                record.update(number=number, file=f'figure_{number}.png', sha256=hashlib.sha256(payload).hexdigest())
+                manifest['figures'].append(record)
+                rendered.append((record['file'], payload))
+        finally:
+            for number in set(plt.get_fignums()) - existing_figures:
+                plt.close(number)
+    # Exclusive creation also protects against concurrent invocations.
+    with ExitStack() as stack:
+        manifest_file = stack.enter_context((output_dir / 'run_manifest.json').open('x', encoding='utf-8'))
+        handles = [(stack.enter_context((output_dir / name).open('xb')), payload) for name, payload in rendered]
+        for handle, payload in handles:
+            handle.write(payload)
+        json.dump(manifest, manifest_file, indent=2, ensure_ascii=False, allow_nan=False)
+        manifest_file.write('\n')
+        if 6 in figures:
+            import csv
+            from pollen_corroboration import MASS_FIELDS
+            record = next(r for r in manifest['figures'] if r['number']==6)
+            with (output_dir/'pollen_grains_per_gram.csv').open('x', encoding='utf-8', newline='') as stream:
+                writer = csv.DictWriter(stream, fieldnames=MASS_FIELDS, extrasaction='ignore')
+                writer.writeheader()
+                writer.writerows(record['collections'])
+    return manifest
+
+
+def cli(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--data-dir', type=Path, required=True, help='Extracted data directory')
+    parser.add_argument('--output-dir', type=Path, required=True, help='Fresh output directory; existing files are protected')
+    parser.add_argument('--figure', type=int, choices=range(1, 9), action='append', help='Figure number; repeat to select several (default: all eight)')
+    parser.add_argument('--statistics-dir', type=Path, help='Recomputed category_descriptives, category_contrasts and bootstrap_summary CSV exports')
+    parser.add_argument('--scalar-dir', type=Path, help='Recomputed SI collection_scalars.csv directory (overrides statistics-dir scalar selection)')
+    args = parser.parse_args(argv)
+    manifest = render(args.data_dir, args.output_dir, args.figure, args.statistics_dir, args.scalar_dir)
+    print(f"Rendered {len(manifest['figures'])} figures; manifest: {args.output_dir / 'run_manifest.json'}")
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(cli())
