+"""Restyle saved historical size curves without recalculating their selection."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import numpy as np
+import pandas as pd
+import matplotlib.pyplot as plt
+from matplotlib.ticker import FuncFormatter
+import plot_helpers as h
+from tick_format import tick_label
+
+SPECS = [
+    ('archive_87e47254ed07','PM1-10','PM1-10',True),
+    ('archive_c8b91b6d34bf','PM1','PM1',True),
+    ('archive_c716d286e5a3','PM10','PM10',True),
+    ('archive_eac5ace40a7c','all_collections','all_collections',True),
+    ('archive_0ff38bca8541','superPM10','superPM10',True),
+    ('archive_9a0993e7af7e',None,'FOUR_CATEGORY_DISTRIBUTIONS',True),
+]
+
+
+def array_hash(values):
+    return hashlib.sha256(np.asarray(values,dtype='float64').tobytes()).hexdigest()
+
+
+def render(inputs, output):
+    inputs,output=Path(inputs),Path(output)
+    if output.exists() and any(output.iterdir()):
+        raise ValueError('Choose a fresh output directory')
+    output.mkdir(parents=True,exist_ok=True)
+    source_manifest=json.loads((inputs/'manifest.json').read_text())
+    tables={}
+    for name in ('category_cohort_curves.csv','full_selection_curves.csv'):
+        data=(inputs/name).read_bytes()
+        if hashlib.sha256(data).hexdigest()!=source_manifest['files'][name]:
+            raise ValueError('Changed saved curve table: '+name)
+        tables[name]=pd.read_csv(inputs/name,float_precision='round_trip')
+    settings,font=h.style_settings(Path(__file__).resolve().parents[1]/'assets/fonts/lmroman12-regular.otf')
+    report=dict(style='Current manuscript typography, colours, markers and line layering',
+                saved_values_recalculated=False,font=font,figures=[])
+    with plt.rc_context(settings):
+        for identity,cohort,stem,pdf in SPECS:
+            table=tables['full_selection_curves.csv'] if cohort is None else tables['category_cohort_curves.csv']
+            if cohort is not None:table=table.loc[table.mass_cohort.eq(cohort)]
+            if set(table.category)!=set(h.CATS):raise ValueError('Missing category')
+            counts={}; groups={}
+            for category in h.CATS:
+                group=table.loc[table.category.eq(category)].sort_values('diameter_m')
+                if group.diameter_m.duplicated().any() or not np.isfinite(group[['diameter_m','number','surface','volume']]).all().all():
+                    raise ValueError('Invalid saved curve')
+                if group.n.nunique()!=1:raise ValueError('Ambiguous collection count')
+                groups[category]=group
+                counts[category]=int(group.n.iloc[0])
+            fig,axes=plt.subplots(3,2,figsize=(h.WIDTH,9.0))
+            fig.subplots_adjust(left=.16,right=.98,bottom=.17,top=.85,wspace=.53,hspace=.76)
+            h.category_legend(fig,counts)
+            values=[]
+            for row,(field,symbol,power,title) in enumerate([
+                ('number','N',0,'Number'),('surface','S',2,'Sphere surface area'),('volume','V',3,'Volume')]):
+                for col in range(2):
+                    ax=axes[row,col];high=0.;low_diam=[];high_diam=[]
+                    for category,color,fill in zip(h.CATS,h.COLORS,h.FILLS):
+                        group=groups[category]
+                        x=group.diameter_m.to_numpy()*1e6
+                        y=group[field].to_numpy()
+                        visible=x>=.777 if col else np.ones(len(x),dtype=bool)
+                        if not visible.any():raise ValueError('Empty zoom')
+                        ax.scatter(x[visible],y[visible],s=6,facecolor=fill,edgecolor=color,linewidth=.3,zorder=2)
+                        line,=ax.plot(x[visible],y[visible],color=color,linewidth=1.4,zorder=4)
+                        assert np.array_equal(line.get_ydata(),y[visible])
+                        assert np.array_equal(line.get_xdata()/1e6,x[visible]/1e6)
+                        high=max(high,float(y[visible].max()));low_diam.append(x.min());high_diam.append(x.max())
+                        values.append(dict(panel=chr(97+row*2+col),category=category,
+                            saved_y_sha256=array_hash(y[visible]),plotted_y_sha256=array_hash(line.get_ydata()),
+                            points=int(visible.sum())))
+                    ax.set_xscale('log')
+                    ticks=[1,2,5,10] if col else [.01,.1,1,10]
+                    ax.set_xticks(ticks,[f'{v:g}' for v in ticks])
+                    ax.set_xlim((.777 if col else min(low_diam)),max(high_diam))
+                    ax.set_ylim(0,high*1.12 if high else 1)
+                    ax.yaxis.set_major_formatter(FuncFormatter(tick_label))
+                    units='cm$^{-3}$' if not power else rf'$\mu$m$^{power}$ cm$^{{-3}}$'
+                    ax.set_ylabel(rf'$\mathrm{{d{symbol}/d\log D_p}}$'+'\n'+units)
+                    ax.set_xlabel(r'Diameter ($\mu$m)')
+                    h.axes_style(ax)
+                    h.panel_title(ax,chr(97+row*2+col),title+(' — zoom' if col else ''))
+            if cohort is None:
+                cohort_name='Size-available collections'
+            elif cohort=='all_collections':
+                cohort_name='Original mass-availability selection: all collections'
+            else:
+                cohort_name='Original mass-availability selection: '+h.PM[cohort]
+            fig.text(.02,.055,cohort_name+'\nSaved numerical curves and original diameter treatment; no new density conversion.\n'+r'Surface area retains the original sphere definition ($\pi D^{2}$), distinct from projected area ($\pi D^{2}/4$).',fontsize=9)
+            destination=output/identity;destination.mkdir()
+            fig.savefig(destination/(stem+'.png'),dpi=h.DPI)
+            if pdf:fig.savefig(destination/(stem+'.pdf'),dpi=h.DPI)
+            report['figures'].append(dict(id=identity,cohort=cohort,counts=counts,series=values,
+                files=[dict(name=p.name,sha256=hashlib.sha256(p.read_bytes()).hexdigest()) for p in sorted(destination.iterdir())]))
+            plt.close(fig)
+    (output/'STYLE_MANIFEST.json').write_text(json.dumps(report,indent=2,ensure_ascii=False)+'\n',encoding='utf-8')
+    return report
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--inputs',type=Path,required=True)
+    parser.add_argument('--output',type=Path,required=True)
+    args=parser.parse_args()
+    result=render(args.inputs,args.output)
+    print('Restyled',len(result['figures']),'saved historical curve figures; every plotted ordinate matches its table.')
