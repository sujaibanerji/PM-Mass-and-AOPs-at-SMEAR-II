+"""Compact exact-grid labels using the approved decimal HALF_UP formatter."""
+from number_format_snapshot import display_number
+
+
+def compact(value):
+    return value.rstrip('0').rstrip('.') if '.' in value else value
+
+
+def tick_label(value, position=None):
+    label = display_number(value)
+    if r'\times' in label:
+        coefficient, power = label.split(r'\times', 1)
+        return '$' + compact(coefficient) + r'\times' + power + '$'
+    return compact(label)
+
+
+def match_size_ticks(fig, dpi):
+    """Use the manuscript's mathematical number-axis labels and title clearance."""
+    from matplotlib.ticker import FuncFormatter
+    fig.set_dpi(dpi)
+    fig.canvas.draw()
+    ax = fig.axes[0]
+    axis = ax.yaxis
+    x, y = axis.label.get_position()
+    axis.set_label_coords(x, y, transform=axis.label.get_transform())
+    axis.set_major_formatter(FuncFormatter(tick_label))
+    fig.canvas.draw()
+    title_box = axis.label.get_window_extent(fig.canvas.get_renderer())
+    ticks = [t for t, value in zip(ax.get_yticklabels(), ax.get_yticks())
+             if ax.get_ylim()[0] <= value <= ax.get_ylim()[1]]
+    tick_left = min(t.get_window_extent(fig.canvas.get_renderer()).x0 for t in ticks)
+    shift = max(0.0, title_box.x1 - tick_left + 8.0)
+    transform = axis.label.get_transform()
+    location = transform.transform(axis.label.get_position())
+    location[0] -= shift
+    x, y = transform.inverted().transform(location)
+    axis.set_label_coords(x, y, transform=transform)
